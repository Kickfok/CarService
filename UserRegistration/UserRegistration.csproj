<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>UserRegistration</RootNamespace>
    <AssemblyName>UserRegistration</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML-комментарии есть не у каждого открытого члена; предупреждение о пропусках не считается ошибкой сборки. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Сведения о сборке и NuGet-пакете. Версию в CI задает тег релиза: -p:Version=1.2.3 -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>CarService</Product>
    <Company>Kickfok</Company>
    <Authors>Kickfok</Authors>
    <Copyright>Copyright (c) 2023 Kickfok</Copyright>
    <Description>Хеширование паролей PBKDF2-SHA256 со случайной солью и оценка сложности пароля по шкале от 0 до 5. Используется в приложении Car Service.</Description>
    <PackageId>CarService.UserRegistration</PackageId>
    <PackageTags>password;hashing;pbkdf2;password-strength;security</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Kickfok/CarService</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kickfok/CarService</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/Kickfok/CarService/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
