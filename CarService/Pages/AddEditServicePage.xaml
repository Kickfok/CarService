<Page x:Class="CarService.Pages.AddEditServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CarService.Pages"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="1100"
      Title="Добавление услуги">

    <Page.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BlockCommon}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0, 0, 15, 0"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0, 6"/>
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Название"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TBoxTitle" Style="{StaticResource FieldBox}" MaxLength="100"/>

        <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Стоимость, руб."/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TBoxCost" Style="{StaticResource FieldBox}"/>

        <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Длительность, мин"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TBoxDuration" Style="{StaticResource FieldBox}"
                 ToolTip="От 1 до 240 минут"/>

        <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Описание" VerticalAlignment="Top" Margin="0, 8, 15, 0"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TBoxDescription" Style="{StaticResource FieldBox}"
                 Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Скидка, %"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TBoxDiscount" Style="{StaticResource FieldBox}"
                 ToolTip="Целое число от 0 до 100, можно оставить пустым"/>

        <StackPanel Grid.Column="3" Grid.RowSpan="5" VerticalAlignment="Center">
            <Border Margin="5" Height="200" Width="240" BorderBrush="Orange" BorderThickness="1">
                <Image Name="ImageService" Stretch="Uniform"/>
            </Border>

            <Button Height="30" Width="240" Margin="5" Name="BtnSelectImage" Content="Выбрать фотографию" Click="BtnSelectImage_Click" BorderThickness="0" Style="{DynamicResource ServiceButtons}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Height="30" Width="240" Margin="5" Name="BtnSave" Content="Сохранить" Click="BtnSave_Click" BorderThickness="0" Style="{DynamicResource ServiceButtons}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Page>
